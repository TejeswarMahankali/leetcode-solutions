import java.util.*;
class Main {
    void sample2()
    {
        Scanner sc = new Scanner(System.in);
        int n1=sc.nextInt();
        int n2=sc.nextInt();
        int sum=0;
        for(int i=n1;i<=n2;i++)
        {
            sum=sum+i;
        }
        System.out.println(sum);
    }
    public static void main(String[] args) {
        //System.out.println("Start small. Ship something.");
        Main m = new Main();
        m.sample2();
    }
